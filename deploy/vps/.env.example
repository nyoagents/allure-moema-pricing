# Allure Pricing (Projeto Y) — secrets só desta pasta na VPS
# Arquivo: /opt/allure-pricing/deploy/vps/.env
# NÃO copiar de /opt/nyo-kpi-warm (Projeto X / Experts Hub)

# Firebase Admin — projeto Allure Pricing
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Proteção dos crons HTTP (Desbravador sync via app)
CRON_SECRET=allure-pricing-cron-2026

# Webhook opcional se o scraper postar amostras na app
SCRAPER_WEBHOOK_SECRET=allure-scraper-vps-2026

# App em produção (Vercel) — cron de sync Desbravador
ALLURE_APP_URL=https://SEU-APP.vercel.app

# Desbravador CM (quando a Allianza liberar as credenciais de sync)
DESBRAVADOR_USER=
DESBRAVADOR_PASS=
